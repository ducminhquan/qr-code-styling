{
  "compilerOptions": {
    "outDir": "./lib/",
    "sourceMap": true,
    "module": "es2015",
    "target": "es5",
    "lib": ["dom", "es2017"],
    "moduleResolution": "node",
    "declaration": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["./src/**/*.ts"]
}
