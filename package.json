{
  "name": "qr-code-styling-node",
  "version": "1.11.0",
  "description": "Style your QR codes: dots, corners, gradients and a logo. Works in the browser and on Node.js.",
  "keywords": [
    "qr",
    "qrcode",
    "qr-code",
    "js",
    "qrjs",
    "qrstyling",
    "styling",
    "qrbranding",
    "branding",
    "qrimage",
    "image",
    "qrlogo",
    "logo",
    "design",
    "node",
    "svg",
    "canvas",
    "server-side"
  ],
  "homepage": "https://github.com/ducminhquan/qr-code-styling#readme",
  "bugs": {
    "url": "https://github.com/ducminhquan/qr-code-styling/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ducminhquan/qr-code-styling.git"
  },
  "license": "MIT",
  "author": "ducminhquan (https://github.com/ducminhquan)",
  "contributors": [
    "Denys Kozak (original author of qr-code-styling)"
  ],
  "main": "lib/qr-code-styling.js",
  "module": "lib/qr-code-styling.mjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/qr-code-styling.mjs",
      "require": "./lib/qr-code-styling.js",
      "default": "./lib/qr-code-styling.js"
    },
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "unpkg": "lib/qr-code-styling.js",
  "jsdelivr": "lib/qr-code-styling.js",
  "sideEffects": false,
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run clean && npm run build:umd && npm run build:esm && npm run build:types",
    "build:umd": "webpack --mode=production --config webpack.config.build.js",
    "build:esm": "node scripts/build-esm.mjs",
    "build:types": "tsc -p tsconfig.build.json",
    "build:dev": "webpack --mode=development --config webpack.config.build.js",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "webpack serve --open --config webpack.config.dev-server.js",
    "clean": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\"",
    "bench": "npm run build && node scripts/bench.mjs",
    "art-examples": "npm run build && node scripts/art-examples.mjs",
    "style-examples": "npm run build && node scripts/style-examples.mjs",
    "blend-examples": "npm run build && node scripts/blend-examples.mjs",
    "circle-examples": "npm run build && node scripts/circle-examples.mjs"
  },
  "dependencies": {
    "qrcode-generator": "^1.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^2.1.9",
    "canvas": "^3.2.3",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^15.15.0",
    "html-webpack-plugin": "^5.6.8",
    "jsdom": "^26.1.0",
    "jsqr": "^1.4.0",
    "prettier": "^3.10.1",
    "qr-code-styling-node-v1-5": "npm:qr-code-styling-node@1.5.0",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^2.1.9",
    "webpack": "^5.113.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.7",
    "webpack-merge": "^6.0.1"
  }
}
